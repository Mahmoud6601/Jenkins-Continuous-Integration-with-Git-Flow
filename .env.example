# Copy to .env (gitignored) and set strong values before running docker compose up.
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=change_me_strong_jenkins_admin_password
JENKINS_AGENT_SECRET=change_me_64_hex_agent_secret
GITHUB_WEBHOOK_SECRET=change_me_github_webhook_hmac_secret

# Local OCI registry and initial payload tag
REGISTRY_HOST=localhost:5000
STAGING_IMAGE_TAG=local-dev
PROD_IMAGE_TAG=local-dev
APP_HOST=localhost
